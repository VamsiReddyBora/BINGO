<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BingoMultiplayer.NativeLight" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/splash_background_light</item>
        <item name="android:navigationBarColor">@color/splash_background_light</item>
        <item name="android:windowBackground">@color/splash_background_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
    </style>
    <style name="Theme.BingoMultiplayer.Light" parent="Theme.BingoMultiplayer.NativeLight" />
    <style name="Theme.BingoMultiplayer.NativeDark" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
    </style>
    <style name="Theme.BingoMultiplayer.Dark" parent="Theme.BingoMultiplayer.NativeDark" />
</resources>

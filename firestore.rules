rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function activeAccount(uid) {
      return !exists(/databases/$(database)/documents/adminTombstones/$(uid));
    }

    // Only the administrative service account can create or remove these markers.
    match /adminTombstones/{userId} {
      allow read, write: if false;
    }

    // User profile and settings
    match /users/{userId} {
      // Preserve existing public profile queries; block deleted identities from writing.
      allow read: if true;
      allow write: if activeAccount(userId);

      // Match history subcollection
      match /matches/{matchId} {
        allow read: if true;
        allow write: if activeAccount(userId);
      }

      // Pending social requests follow the existing friendly-game storage policy.
      // Preserve admin deletion markers and the deployed profile/history/friends rules.
      match /friendRequests/{senderId} {
        allow read: if true;
        allow create, update: if activeAccount(userId) && activeAccount(senderId) &&
          request.resource.data.keys().hasOnly(['id', 'fromUid', 'fromUsername', 'fromDisplayName',
            'fromAvatarUrl', 'toUid', 'toUsername', 'status', 'timestamp']) &&
          request.resource.data.fromUid == senderId && request.resource.data.toUid == userId &&
          senderId != userId && request.resource.data.id is string && request.resource.data.id.size() > 0 &&
          request.resource.data.fromUsername is string && request.resource.data.toUsername is string &&
          request.resource.data.fromDisplayName is string &&
          request.resource.data.status in ['PENDING', 'ACCEPTED', 'DECLINED'] &&
          request.resource.data.timestamp is int && request.resource.data.timestamp > 0;
        allow delete: if activeAccount(userId) && activeAccount(senderId);
      }

      // Friends subcollection
      match /friends/{friendId} {
        allow read: if true;
        // One owner lookup also preserves large friend-list batch writes in older APKs.
        // Deletion cleanup leaves removal markers on the other side of the friendship.
        allow write: if activeAccount(userId);
      }
    }

    // Unique username registry
    match /usernames/{username} {
      allow read: if true;
      allow create, update: if activeAccount(request.resource.data.uid);
      allow delete: if activeAccount(resource.data.uid);
    }
  }
}
